	file = {PDF:C\:\\Users\\Marian\\Zotero\\storage\\2ABVSJBI\\Tamilvanan et al. - 2026 - A Comprehensive Survey of Machine Learning Algorithms in Hand Gesture Recognition for Myoelectric Pr.pdf:application/pdf},
}

@article{igual_myoelectric_2019,

	keywords = {Computer Science - Machine Learning},
	file = {PDF:C\:\\Users\\Marian\\Zotero\\storage\\J9XH6VP6\\Chudinov et al. - 2026 - NeuroEdge Real-Time Hand Gesture Recognition with High-Density EMG Using Deep Learning at the Edge.pdf:application/pdf},
}


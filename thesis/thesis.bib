}

@article{tamilvanan_comprehensive_2026,
	title = {A {Comprehensive} {Survey} of {Machine} {Learning} {Algorithms} in {Hand} {Gesture} {Recognition} for {Myoelectric} {Prosthetic} {Control}: {Current} {Trends}, {Challenges} and {Future} {Directions}},

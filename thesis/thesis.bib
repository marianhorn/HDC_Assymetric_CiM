	pages = {1--40},
	file = {PDF:C\:\\Users\\Marian\\Zotero\\storage\\G298U472\\Kleyko et al. - 2023 - A Survey on Hyperdimensional Computing aka Vector Symbolic Architectures, Part I Models and Data Tr.pdf:application/pdf},
